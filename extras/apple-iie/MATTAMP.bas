10 REM MATTAMP //E - THE 300 BPS EDITION
20 REM ORIGINAL APPLESOFT BASIC COMPANION
30 REM NO NETWORK OR STREAMING. DEMO METERS.
40 TEXT : HOME : NORMAL
50 DIM S$(8),T(39),X(3),H(3),N$(3),C(3)
60 FOR I = 1 TO 8 : READ S$(I) : NEXT I
70 N$(1) = "BYTE" : N$(2) = "FLOPPY" : N$(3) = "MODEM"
80 C(0) = 12 : C(1) = 9 : C(2) = 3 : C(3) = 6
90 ST = 1 : VO = 6 : BS = 0 : NM$ = "MAT"
100 PRINT "MATTAMP //E": PRINT "THE 300 BPS EDITION": PRINT
110 PRINT "PLEASE SEAT HANDSET FIRMLY.": PRINT CHR$(7)
120 INPUT "YOUR INITIALS (1-3): ";NM$
130 NM$ = LEFT$(NM$,3) : IF NM$ = "" THEN NM$ = "MAT"
140 N$(0) = NM$ : ZZ = RND(-1-PEEK(78))
200 TEXT : HOME : NORMAL
210 INVERSE : PRINT "            MATTAMP //E             " : NORMAL
220 PRINT : PRINT "1  RADIO / MODEM DEMO"
230 PRINT : PRINT "2  AMP ARTILLERY - FOUR TINY TANKS"
240 PRINT : PRINT "3  ABOUT THIS VERY SILLY PORT"
250 PRINT : PRINT "Q  QUIT TO BASIC"
260 PRINT : PRINT "SESSION BEST: ";BS;"  PILOT: ";NM$
270 PRINT : PRINT "REAL BASIC. FAKE INTERNET."
280 PRINT : PRINT "SELECT A KEY: "; : GET K$
290 IF K$ = "1" THEN GOTO 1000
300 IF K$ = "2" THEN GOTO 3000
310 IF K$ = "3" THEN GOTO 8000
320 IF K$ <> "Q" AND K$ <> "q" THEN GOTO 280
330 HOME : PRINT "NO CARRIER.": PRINT "THANKS FOR WASTING 64K WITH US.": END
1000 REM LO-RES RADIO DISPLAY, ALL DATA FAKE
1010 GR : HOME : COLOR= 4
1020 HLIN 0,39 AT 0 : HLIN 0,39 AT 39
1030 VLIN 0,39 AT 0 : VLIN 0,39 AT 39
1040 COLOR= 2 : FOR Y = 2 TO 15 : HLIN 2,18 AT Y : NEXT Y
1050 COLOR= 9 : FOR Y = 5 TO 11 : HLIN 7,13 AT Y : NEXT Y
1060 COLOR= 3 : FOR I = 0 TO 8 : HLIN 10-I,10+I AT 12+I : NEXT I
1070 COLOR= 6 : FOR Y = 21 TO 27 : HLIN 2,18 AT Y : NEXT Y
1080 COLOR= 14 : FOR I = 0 TO 5 : HLIN 8,12 AT 21+I : NEXT I
1090 FOR I = 0 TO 15 : COLOR= I : HLIN 2+I*2,3+I*2 AT 36 : NEXT I
1100 GOSUB 1400
1110 FOR I = 0 TO 7
1120 COLOR= 0 : VLIN 3,27 AT 22+I*2
1130 B = 3+INT(RND(1)*19)
1140 COLOR= 12 : VLIN 28-B,27 AT 22+I*2
1150 COLOR= 13 : PLOT 22+I*2,28-B
1160 NEXT I
1170 IF PEEK(49152) < 128 THEN GOTO 1110
1180 GET K$ : POKE 49168,0
1190 IF K$ = "Q" OR K$ = "q" THEN GOTO 200
1200 IF K$ >= "1" AND K$ <= "8" THEN ST = VAL(K$)
1210 IF K$ = "+" AND VO < 10 THEN VO = VO+1
1220 IF K$ = "-" AND VO > 0 THEN VO = VO-1
1230 GOSUB 1400 : GOTO 1110
1400 HOME : VTAB 21 : PRINT "DEMO: ";S$(ST)
1410 PRINT "1250000 BPS = 4167 OLD MODEMS!"
1420 PRINT "1-8 STATION  +/- VOL ";VO;"  Q MENU"
1430 PRINT "SIMULATED METERS. SILENCE IS GOLDEN.";
1440 RETURN
3000 REM TERRAIN AND FOUR TANKS
3010 SC = 0 : AN = 45 : PW = 30 : WI = (INT(RND(1)*5)-2)/100
3020 PH = RND(1)*6.28
3030 FOR I = 0 TO 39 : T(I) = INT(28+4*SIN(I/6+PH)+2*SIN(I/3)) : NEXT I
3040 FOR I = 0 TO 3 : X(I) = 4+I*10 : H(I) = 100 : NEXT I
3050 TU = 0 : GOSUB 7100
3060 AL = 0 : FOR I = 0 TO 3 : IF H(I) > 0 THEN AL = AL+1 : WT = I
3070 NEXT I : IF AL < 2 THEN GOTO 6000
3080 IF H(TU) < 1 THEN GOTO 3900
3090 IF TU <> 0 THEN GOTO 4000
3100 HOME : VTAB 21 : PRINT NM$;" HP ";H(0);"  ANG ";AN;"  PWR ";PW
3110 PRINT "A/D ANGLE  W/S POWER  SPACE FIRE"
3120 PRINT "Q MENU  WIND ";INT(WI*100);"  SCORE ";SC
3130 PRINT "BYTE ";H(1);" FLOPPY ";H(2);" MODEM ";H(3);
3140 GET K$
3150 IF K$ = "Q" OR K$ = "q" THEN GOTO 200
3160 IF K$ = "A" OR K$ = "a" THEN AN = AN+5
3170 IF K$ = "D" OR K$ = "d" THEN AN = AN-5
3180 IF K$ = "W" OR K$ = "w" THEN PW = PW+2
3190 IF K$ = "S" OR K$ = "s" THEN PW = PW-2
3200 IF AN < 5 THEN AN = 5
3210 IF AN > 175 THEN AN = 175
3220 IF PW < 2 THEN PW = 2
3230 IF PW > 100 THEN PW = 100
3240 IF K$ <> " " AND K$ <> CHR$(13) THEN GOTO 3100
3250 AG = AN : PO = PW : GOTO 4500
3900 TU = TU+1 : IF TU > 3 THEN TU = 0
3910 GOTO 3060
4000 REM BOTS PICK ANY LIVING RIVAL
4010 TG = INT(RND(1)*4)
4020 IF TG = TU OR H(TG) < 1 THEN GOTO 4010
4030 AG = 35+INT(RND(1)*31)
4040 IF X(TG) < X(TU) THEN AG = 180-AG
4050 DS = ABS(X(TG)-X(TU))
4060 PO = INT((SQR(DS*.14)-.4)*24)+INT(RND(1)*13)-6
4070 IF PO < 4 THEN PO = 4
4080 HOME : VTAB 21 : PRINT N$(TU);" TAKES A SHOT."
4090 PRINT "ANGLE ";AG;"  POWER ";PO
4100 IF H(0) < 1 THEN PRINT "YOU ARE OUT. WATCH THE GRUDGE MATCH."
4110 FOR DL = 1 TO 150 : NEXT DL
4500 REM BALLISTICS: X/Y VELOCITY, GRAVITY
4510 PX = X(TU) : PY = T(PX)-3
4520 VX = COS(AG*.0174533)*(PO/24+.4)
4530 VY = -SIN(AG*.0174533)*(PO/24+.4)
4540 FT = 0
4550 PX = PX+VX : PY = PY+VY : VY = VY+.14 : VX = VX+WI
4560 FT = FT+1 : IF PX < 0 OR PX > 39 OR FT > 180 THEN GOTO 4900
4570 IF PY < 0 THEN GOTO 4550
4580 IX = INT(PX) : IY = INT(PY)
4590 IF IY >= T(IX) THEN GOTO 5000
4600 COLOR= 15 : PLOT IX,IY
4610 FOR J = 0 TO 3
4620 IF H(J) > 0 AND FT > 1 AND ABS(PX-X(J)) < 2 AND ABS(PY-T(X(J))+1) < 2 THEN GOTO 5000
4630 NEXT J : GOTO 4550
4900 HOME : VTAB 21 : PRINT "THAT CLOUD HAD IT COMING."
4910 FOR DL = 1 TO 200 : NEXT DL
4920 GOSUB 7100 : GOTO 3900
5000 REM BLAST DAMAGE AND A SMALL CRATER
5010 COLOR= 9
5020 FOR BX = IX-3 TO IX+3 : FOR BY = IY-3 TO IY+3
5030 IF BX < 0 OR BX > 39 OR BY < 0 OR BY > 39 THEN GOTO 5050
5040 IF (BX-IX)^2+(BY-IY)^2 < 12 THEN PLOT BX,BY
5050 NEXT BY : NEXT BX
5060 PRINT CHR$(7); : HT = 0
5070 FOR J = 0 TO 3
5080 DS = SQR((PX-X(J))^2+(PY-T(X(J)))^2)
5090 DM = INT(110-DS*20) : IF DM < 1 OR H(J) < 1 THEN GOTO 5150
5100 IF DM > H(J) THEN DM = H(J)
5110 H(J) = H(J)-DM : HT = 1
5120 IF TU = 0 AND J <> 0 THEN SC = SC+DM*10
5130 IF TU = 0 AND J <> 0 AND H(J) = 0 THEN SC = SC+500
5150 NEXT J
5160 FOR J = IX-2 TO IX+2
5170 IF J < 0 OR J > 39 THEN GOTO 5200
5180 T(J) = T(J)+3-ABS(J-IX) : IF T(J) > 37 THEN T(J) = 37
5200 NEXT J
5210 HOME : VTAB 21
5220 IF HT = 1 THEN PRINT "A STRONGLY WORDED CRATER."
5230 IF HT = 0 THEN PRINT "EXCELLENT SHOT. WRONG ZIP CODE."
5240 FOR DL = 1 TO 250 : NEXT DL
5250 GOSUB 7100 : GOTO 3900
6000 IF AL = 0 THEN GOTO 6040
6010 IF WT = 0 THEN SC = SC+1000
6020 HOME : VTAB 21 : PRINT N$(WT);" OWNS THIS VERY SMALL HILL."
6030 GOTO 6050
6040 HOME : VTAB 21 : PRINT "EVERYONE LOST. VERY EFFICIENT."
6050 IF SC > BS THEN BS = SC
6060 PRINT "SCORE ";SC;"  SESSION BEST ";BS
6070 PRINT "N NEW BATTLE / Q MENU"
6080 GET K$
6090 IF K$ = "N" OR K$ = "n" THEN GOTO 3000
6100 IF K$ = "Q" OR K$ = "q" THEN GOTO 200
6110 GOTO 6080
7100 GR : HOME
7110 COLOR= 4 : HLIN 0,39 AT 0 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
7120 FOR XX = 0 TO 39
7130 COLOR= 8 : VLIN T(XX),39 AT XX
7140 COLOR= 12 : PLOT XX,T(XX)
7150 NEXT XX
7160 FOR J = 0 TO 3
7170 IF H(J) < 1 THEN GOTO 7210
7180 COLOR= C(J) : YY = T(X(J))-1
7190 HLIN X(J)-1,X(J)+1 AT YY : PLOT X(J),YY-1
7200 COLOR= 15 : PLOT X(J)+1,YY-2
7210 NEXT J : RETURN
8000 TEXT : HOME
8010 PRINT "MATTAMP //E - AN OFFLINE HOMAGE": PRINT
8020 PRINT "RADIO ART + METERS ARE A DEMO."
8030 PRINT "NO DI.FM, YOUTUBE, X OR LIVE CAMS."
8040 PRINT "NO SERIAL CARD OR ECHO DRIVER USED."
8050 PRINT "BEEPS USE THE BUILT-IN SPEAKER.": PRINT
8060 PRINT "16-COLOR GR. 40 X 40 + 4 TEXT LINES."
8070 PRINT "NO MACHINE CODE. NO EXTRA CARD."
8080 PRINT "ARTILLERY IS REAL. THE BOTS ARE RUDE."
8090 PRINT "BEST SCORE LASTS UNTIL YOU QUIT.": PRINT
8100 PRINT "PRESS ANY KEY. DO NOT PICK UP PHONE."
8110 GET K$ : GOTO 200
9000 DATA FUTURE SYNTHPOP,CLASSIC TRANCE,DEEP HOUSE,SYNTHWAVE
9010 DATA PROGRESSIVE,LIQUID DNB,CHILLOUT,PSYCHILL
